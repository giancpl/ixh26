FROM python:3.11-slim-bookworm@sha256:a83ba18aef0f865b1a4a611c2cf460fe446f2795673bbb9fe43be570439e3b39
WORKDIR /app
COPY requirements-server.lock ./
RUN --mount=type=cache,target=/root/.cache/pip pip install -r requirements-server.lock
COPY pyproject.toml README.md ./
COPY settlement ./settlement
COPY server ./server
COPY upp_protocol ./upp_protocol
COPY social ./social
RUN pip install --no-deps . && pip check
COPY contracts ./contracts
COPY tests ./tests
COPY scripts ./scripts
COPY docker/regtest/client.conf /config/client.conf
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "server"]
