% ============================================================
%  beamerthemeLagrange.sty
%
%  Uso:
%    \usetheme[lagrange]{Lagrange}   % grigio Apple (default)
%    \usetheme[cauchy]{Lagrange}     % bianco minimal
%    \usetheme[fermat]{Lagrange}     % nero minimal
%
%  Compatible with pdfLaTeX
% ============================================================

\ProvidesPackage{beamerthemeLagrange}[2026/05/14 Lagrange Beamer Theme]

\RequirePackage{tikz}
\RequirePackage{pgfopts}
\usetikzlibrary{positioning,arrows.meta,calc}
\RequirePackage[most]{tcolorbox}
\RequirePackage{microtype}

% ── Opzioni profilo ──────────────────────────────────────────
% default: lagrange
\newif\if@profLagrange  \@profLagrangetrue
\newif\if@profCauchy    \@profCauchyfalse
\newif\if@profFermat    \@profFermatfalse

\newcommand{\subsubtitle}[1]{\def\insertsubsubtitle{#1}}
\def\insertsubsubtitle{}

\pgfkeys{
  /lagrange/.cd,
  lagrange/.code = {\@profLagrangetrue \@profCauchyfalse \@profFermatfalse},
  cauchy/.code   = {\@profLagrangefalse\@profCauchytrue  \@profFermatfalse},
  fermat/.code   = {\@profLagrangefalse\@profCauchyfalse \@profFermattrue },
}
\ProcessPgfOptions{/lagrange}

% ── Palette ─────────────────────────────────────────────────
\definecolor{kn-bg}   {HTML}{F5F5F7}
\definecolor{kn-fg}   {HTML}{1D1D1F}
\definecolor{kn-blue} {HTML}{0066CC}
\definecolor{kn-green}{HTML}{28A745}
\definecolor{kn-red}  {HTML}{FF3B30}
\definecolor{kn-muted}{HTML}{6E6E73}
\definecolor{kn-rule} {HTML}{D2D2D7}
\definecolor{kn-block}{HTML}{E8E8ED}


% ── Palette Lagrange (grigio Apple) ──────────────────────────
\if@profLagrange
  \definecolor{kn-bg}   {HTML}{F5F5F7}
  \definecolor{kn-fg}   {HTML}{1D1D1F}
  \definecolor{kn-acc}  {HTML}{0066CC}   % accento principale
  \definecolor{kn-green}{HTML}{28A745}
  \definecolor{kn-red}  {HTML}{FF3B30}
  \definecolor{kn-muted}{HTML}{6E6E73}
  \definecolor{kn-rule} {HTML}{D2D2D7}
  \definecolor{kn-block}{HTML}{E8E8ED}
  \definecolor{kn-titlebg}{HTML}{0066CC} % barra titolo
\fi

% ── Palette Cauchy (bianco minimal) ──────────────────────────
\if@profCauchy
  \definecolor{kn-bg}   {HTML}{FFFFFF}
  \definecolor{kn-fg}   {HTML}{111111}
  \definecolor{kn-acc}  {HTML}{111111}
  \definecolor{kn-green}{HTML}{2D7A3A}
  \definecolor{kn-red}  {HTML}{CC2200}
  \definecolor{kn-muted}{HTML}{888888}
  \definecolor{kn-rule} {HTML}{CCCCCC}
  \definecolor{kn-block}{HTML}{F0F0F0}
  \definecolor{kn-titlebg}{HTML}{111111}
\fi

% ── Palette Fermat (nero minimal) ────────────────────────────
\if@profFermat
  \definecolor{kn-bg}   {HTML}{0D0D0D}
  \definecolor{kn-fg}   {HTML}{F0F0F0}
  \definecolor{kn-acc}  {HTML}{EEEEEE}
  \definecolor{kn-green}{HTML}{4EC97B}
  \definecolor{kn-red}  {HTML}{FF5C52}
  \definecolor{kn-muted}{HTML}{888888}
  \definecolor{kn-rule} {HTML}{333333}
  \definecolor{kn-block}{HTML}{1E1E1E}
  \definecolor{kn-titlebg}{HTML}{F0F0F0}
\fi

% ── Struttura Beamer ─────────────────────────────────────────
\usetheme{default}
\useinnertheme{default}
\useoutertheme{default}
\setbeamertemplate{navigation symbols}{}

% ── Colori Beamer ────────────────────────────────────────────
\setbeamercolor{normal text}         {fg=kn-fg,   bg=kn-bg}
\setbeamercolor{alerted text}        {fg=kn-red}
\setbeamercolor{example text}        {fg=kn-green}
\setbeamercolor{background canvas}   {bg=kn-bg}
\setbeamercolor{frametitle}          {fg=kn-fg,   bg=kn-bg}
\setbeamercolor{title}               {fg=kn-fg}
\setbeamercolor{author}              {fg=kn-fg}
\setbeamercolor{footline}            {fg=kn-muted,bg=kn-bg}
\setbeamercolor{section in toc}      {fg=kn-fg}
\setbeamercolor{subsection in toc}   {fg=kn-muted}
\setbeamercolor{itemize item}        {fg=kn-acc}
\setbeamercolor{itemize subitem}     {fg=kn-muted}
\setbeamercolor{block title}         {fg=kn-fg,   bg=kn-block}
\setbeamercolor{block body}          {fg=kn-fg,   bg=kn-block}
\setbeamercolor{block title alerted} {fg=white,   bg=kn-red}
\setbeamercolor{block body alerted}  {fg=kn-fg,   bg=kn-red!8}
\setbeamercolor{block title example} {fg=white,   bg=kn-green}
\setbeamercolor{block body example}  {fg=kn-fg,   bg=kn-green!8}
\setbeamercolor{subsubtitle}{fg=kn-acc}

% ── Font ─────────────────────────────────────────────────────
\setbeamerfont{title}         {size=\LARGE,      series=\bfseries}
\setbeamerfont{subtitle}      {size=\large,      series=\mdseries}
\setbeamerfont{subsubtitle}{size=\small,series=\mdseries}
\setbeamerfont{author}        {size=\normalsize, series=\mdseries}
\setbeamerfont{institute}     {size=\small}
\setbeamerfont{date}          {size=\small}
\setbeamerfont{frametitle}    {size=\large,      series=\bfseries}
\setbeamerfont{framesubtitle} {size=\small,      series=\mdseries}
\setbeamerfont{block title}   {size=\small,      series=\bfseries}
\setbeamerfont{footline}      {size=\tiny}

% ── Background ───────────────────────────────────────────────
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
    \fill[kn-bg] (0,0) rectangle (\paperwidth,\paperheight);
  \end{tikzpicture}%
}

% ── Frametitle ───────────────────────────────────────────────
% Fermat: la riga decorativa è bianca; Cauchy: è nera; Lagrange: blu.
% kn-acc gestisce già tutto.
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \vspace{0.38cm}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=0.6cm,rightskip=0.6cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\empty\else
      \\[-0.05em]%
      \usebeamerfont{framesubtitle}\textcolor{kn-muted}{\insertframesubtitle}%
    \fi
  \end{beamercolorbox}%
}

% ── Title page ───────────────────────────────────────────────
% Cauchy: barra nera sottile in alto; Fermat: barra bianca; Lagrange: blu.
% In tutti e tre la background della slide titolo è kn-bg (no override).
\defbeamertemplate*{title page}{lagrange}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[kn-bg](current page.south west) rectangle (current page.north east);
    \fill[kn-titlebg]
      (current page.north west) rectangle
      ([yshift=-0.5cm]current page.north east);
    \draw[kn-rule,line width=0.5pt]
      ([yshift=1.4cm]current page.south west) --
      ([yshift=1.4cm]current page.south east);
    \node[anchor=south east,inner sep=0.45cm,
          font=\scriptsize\color{kn-muted}]
      at (current page.south east) {\insertdate};
  \end{tikzpicture}%
  \vspace{3.7cm}\par
  \begin{beamercolorbox}[wd=0.88\paperwidth,leftskip=0.6cm]{title}
    \centering\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par
    \ifx\insertsubtitle\empty\else
      \vspace{0.1em}
      {\usebeamerfont{subtitle}\textcolor{kn-muted}{\insertsubtitle}\par}
    \fi
    \vspace{-0.5em}
    \textcolor{kn-acc}{\rule{2.2cm}{1.5pt}\\}
    \vspace{0.1cm}
    \ifx\insertsubsubtitle\empty\else
      {\usebeamerfont{subsubtitle}
       \usebeamercolor[fg]{subsubtitle}
       \insertsubsubtitle\par}
    \fi
  \end{beamercolorbox}
  \vspace{0.1cm}
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=0.6cm]{author}
    \usebeamerfont{author}\insertauthor\par
    \vspace{1em}
    {\usebeamerfont{institute}\textcolor{kn-muted}{\insertinstitute}\par}
  \end{beamercolorbox}
}

% ── Footline ─────────────────────────────────────────────────
\setbeamertemplate{footline}{%
\vspace{-200em}
  \begin{tikzpicture}[overlay,remember picture]
    \draw[kn-rule,line width=0.4pt]
      ([yshift=0.52cm]current page.south west) --
      ([yshift=0.52cm]current page.south east);
  \end{tikzpicture}%
  \vspace{-10em}
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.45cm,dp=0.08cm,
      leftskip=0.5cm,rightskip=0.5cm]{footline}%
    \usebeamerfont{footline}%
    \textcolor{kn-muted}{\insertshortauthor}%
    \hfill
    \textcolor{kn-muted}{\insertshorttitle}%
    \hfill
    \textcolor{kn-acc}{\insertframenumber}%
    \textcolor{kn-rule}{/\inserttotalframenumber}%
  \end{beamercolorbox}%
}

% ── Bullets ──────────────────────────────────────────────────
\setbeamertemplate{itemize item}{%
  \tikz[baseline=-0.6ex]\fill[kn-acc](0,0) circle (2.3pt);%
}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-0.6ex]\fill[kn-muted](0,0) circle (1.7pt);%
}
\setbeamertemplate{itemize subsubitem}{%
  \tikz[baseline=-0.6ex]\draw[kn-muted,line width=0.8pt](0,0) circle (1.5pt);%
}
\setbeamertemplate{enumerate item}{%
  \tikz[baseline=-0.6ex]{%
    \fill[kn-acc](0,0) circle (7pt);%
    \node[text=kn-bg,font=\tiny\bfseries] at (0,0) {\insertenumlabel};%
  }%
}

% ── TOC ──────────────────────────────────────────────────────
\setbeamertemplate{section in toc}{%
  \tikz[baseline=-0.5ex]\fill[kn-acc](0,0) circle (2.8pt);%
  \hspace{0.5em}{\usebeamercolor[fg]{section in toc}\inserttocsection}%
}
\setbeamertemplate{subsection in toc}{%
  \hspace{1.4em}%
  \tikz[baseline=-0.5ex]\fill[kn-muted](0,0) circle (1.8pt);%
  \hspace{0.4em}{\small\textcolor{kn-muted}{\inserttocsubsection}}%
}

% ── Section interstitial ─────────────────────────────────────
\AtBeginSection[]{%
  \begin{frame}[noframenumbering,plain]
    \vfill
    \begin{center}
      \textcolor{kn-muted}{\small Section \thesection}\\[0.4em]
      {\LARGE\bfseries\color{kn-fg}\insertsectionhead}
    \end{center}
    \vfill
  \end{frame}%
}

% ── Standard blocks ──────────────────────────────────────────
\setbeamertemplate{blocks}[rounded][shadow=false]

% ── tcolorbox environments ───────────────────────────────────
\newtcolorbox{knbox}[1][]{
  enhanced,breakable,
  colback=kn-acc!5,colframe=kn-acc,
  coltitle=kn-bg,fonttitle=\small\bfseries\sffamily,
  title={#1},arc=4pt,boxrule=0.7pt,
  left=6pt,right=6pt,top=6pt,bottom=4pt,
  attach boxed title to top left={yshift=-1.9mm,xshift=-10pt},
  boxed title style={colback=kn-acc,arc=3pt,boxrule=0pt,
    left=4pt,right=4pt,top=2pt,bottom=2pt},
}
\newtcolorbox{knfact}[1][]{
  enhanced,breakable,
  colback=kn-green!6,colframe=kn-green,
  coltitle=white,fonttitle=\small\bfseries\sffamily,
  title={#1},arc=4pt,boxrule=0.7pt,
  left=6pt,right=6pt,top=6pt,bottom=4pt,
  attach boxed title to top left={yshift=-1.9mm,xshift=-10pt},
  boxed title style={colback=kn-green,arc=3pt,boxrule=0pt,
    left=4pt,right=4pt,top=2pt,bottom=2pt},
}
\newtcolorbox{knwarn}[1][]{
  enhanced,breakable,
  colback=kn-red!5,colframe=kn-red,
  coltitle=white,fonttitle=\small\bfseries\sffamily,
  title={#1},arc=4pt,boxrule=0.7pt,
  left=6pt,right=6pt,top=6pt,bottom=4pt,
  attach boxed title to top left={yshift=-1.9mm,xshift=-10pt},
  boxed title style={colback=kn-red,arc=3pt,boxrule=0pt,
    left=4pt,right=4pt,top=2pt,bottom=2pt},
}
\newtcolorbox{knnote}{
  enhanced,colback=kn-block,colframe=kn-rule,
  arc=4pt,boxrule=0.5pt,
  left=8pt,right=8pt,top=5pt,bottom=5pt,
}