{
  "openapi": "3.1.0",
  "info": {
    "title": "PhoTO local MVP",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/v1/media": {
      "post": {
        "operationId": "uploadMedia",
        "description": "Raw original JPEG, at most 20 MiB. Content-Type image/jpeg. Same bytes return the same URL.",
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New JPEG stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Media"
                }
              }
            }
          },
          "200": {
            "description": "Identical JPEG already stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Media"
                }
              }
            }
          },
          "413": {
            "description": "Media exceeds 20 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JPEG required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JPEG",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/media/{sha256}": {
      "get": {
        "operationId": "getMedia",
        "parameters": [
          {
            "name": "sha256",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Original JPEG bytes, no transformation",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Media not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/posts": {
      "post": {
        "operationId": "createPost",
        "description": "At most 16 KiB. Standard signed kind 20 with exactly one JPEG imeta. Local media URL/hash only. Preserve the event on retry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event"
                ],
                "properties": {
                  "event": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              },
              "example": {
                "event": {
                  "id": "8dde31d4aefacba4eca503449e2b8d8cd4c6934eeecb6004941072ce53fde8ca",
                  "pubkey": "79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798",
                  "created_at": 1700000000,
                  "kind": 20,
                  "tags": [
                    [
                      "title",
                      "PhotoAnchor fixture"
                    ],
                    [
                      "imeta",
                      "url http://127.0.0.1:8080/v1/media/91377b7d9ce503a2e51f1ae1acc388892012d3a293319fbfaf7959e126c35920",
                      "m image/jpeg",
                      "x 91377b7d9ce503a2e51f1ae1acc388892012d3a293319fbfaf7959e126c35920",
                      "dim 64x48"
                    ],
                    [
                      "m",
                      "image/jpeg"
                    ],
                    [
                      "x",
                      "91377b7d9ce503a2e51f1ae1acc388892012d3a293319fbfaf7959e126c35920"
                    ]
                  ],
                  "content": "PhotoAnchor fixture",
                  "sig": "62177455ec035abfbf58f57bfa5684e6ce34782bc78a1be429b5ccf10eb4f38291467f3a11423c670e086226238d0b686ae0570ec7c8cac97880d5a792266f57"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Post persisted and independent relay/settlement jobs queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "200": {
            "description": "Identical signed event already accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "409": {
            "description": "Incompatible event with an existing ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid event, signature, media reference or hash",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 16 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
